generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FormaPagamento {
  FIADO
  BOLETO
  A_VISTA
  PIX
  DINHEIRO
}

enum StatusConta {
  PENDENTE
  PAGO
  ATRASADO
  PERDIDO
}

enum TipoMovimento {
  ENTRADA
  SAIDA
}

enum CategoriaDespesa {
  COMBUSTIVEL
  MANUTENCAO
  IMPOSTO
  MERCADORIA
  OUTROS
}

enum Role {
  ADMIN
  USUARIO
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  role      Role     @default(USUARIO)
  createdAt DateTime @default(now())
}

model Empresa {
  id        Int      @id @default(autoincrement())
  cnpj      String   @unique
  razaoSocial String
  telefone  String?
  createdAt DateTime @default(now())
  vendas    Venda[]
}

model Fornecedor {
  id        Int       @id @default(autoincrement())
  nome      String
  telefone  String?
  createdAt DateTime  @default(now())
  compras   Compra[]
}

model Produto {
  id               Int             @id @default(autoincrement())
  nome             String
  unidade          String
  estoqueAtual     Decimal         @default(0) @db.Decimal(12, 3)
  precoVenda       Decimal         @db.Decimal(12, 2)
  unidadesPorCaixa Decimal?        @db.Decimal(12, 3)
  createdAt        DateTime        @default(now())
  itensCompra      ItemCompra[]
  itensVenda       ItemVenda[]
  ajustes          AjusteEstoque[]
}

model AjusteEstoque {
  id                 Int      @id @default(autoincrement())
  produto            Produto  @relation(fields: [produtoId], references: [id])
  produtoId          Int
  quantidadeAnterior Decimal  @db.Decimal(12, 3)
  quantidadeNova     Decimal  @db.Decimal(12, 3)
  motivo             String?
  createdAt          DateTime @default(now())
}

model Cliente {
  id           Int       @id @default(autoincrement())
  cnpj         String    @unique
  nome         String
  endereco     String?
  responsavel  String?
  telefone     String?
  createdAt    DateTime  @default(now())
  vendas       Venda[]
}

model Compra {
  id             Int            @id @default(autoincrement())
  fornecedor     Fornecedor     @relation(fields: [fornecedorId], references: [id])
  fornecedorId   Int
  data           DateTime
  comNota        Boolean        @default(false)
  formaPagamento FormaPagamento @default(BOLETO)
  vencimento     DateTime?
  itens          ItemCompra[]
  contasPagar    ContaPagar[]
  movimentos     MovimentoCaixa[]
  createdAt      DateTime       @default(now())
}

model ItemCompra {
  id               Int      @id @default(autoincrement())
  compra           Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  compraId         Int
  produto          Produto  @relation(fields: [produtoId], references: [id])
  produtoId        Int
  quantidade       Decimal  @db.Decimal(12, 3)
  custoUnitario    Decimal  @db.Decimal(12, 2)
  unidadesPorCaixa Decimal? @db.Decimal(12, 3)
}

model Venda {
  id             Int             @id @default(autoincrement())
  empresa        Empresa         @relation(fields: [empresaId], references: [id])
  empresaId      Int
  cliente        Cliente         @relation(fields: [clienteId], references: [id])
  clienteId      Int
  data           DateTime
  comNota        Boolean         @default(false)
  formaPagamento FormaPagamento
  itens          ItemVenda[]
  contasReceber  ContaReceber[]
  movimentos     MovimentoCaixa[]
  createdAt      DateTime        @default(now())
}

model ItemVenda {
  id               Int      @id @default(autoincrement())
  venda            Venda    @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  vendaId          Int
  produto          Produto  @relation(fields: [produtoId], references: [id])
  produtoId        Int
  quantidade       Decimal  @db.Decimal(12, 3)
  precoUnitario    Decimal  @db.Decimal(12, 2)
  custoUnitario    Decimal? @db.Decimal(12, 2)
  unidadesPorCaixa Decimal? @db.Decimal(12, 3)
}

model ContaReceber {
  id          Int         @id @default(autoincrement())
  venda       Venda       @relation(fields: [vendaId], references: [id])
  vendaId     Int
  valor       Decimal     @db.Decimal(12, 2)
  vencimento  DateTime
  status      StatusConta @default(PENDENTE)
  pagoEm      DateTime?
  perdidoEm   DateTime?
  motivoPerda String?
  baixa       BaixaRecebimento? @relation(fields: [baixaId], references: [id])
  baixaId     Int?
  movimentos  MovimentoCaixa[]
  createdAt   DateTime    @default(now())
}

model BaixaRecebimento {
  id         Int            @id @default(autoincrement())
  codigo     String         @unique
  data       DateTime       @default(now())
  valorTotal Decimal        @db.Decimal(12, 2)
  contas     ContaReceber[]
  createdAt  DateTime       @default(now())
}

model ContaPagar {
  id          Int              @id @default(autoincrement())
  descricao   String
  categoria   CategoriaDespesa @default(OUTROS)
  valor       Decimal          @db.Decimal(12, 2)
  vencimento  DateTime
  status      StatusConta      @default(PENDENTE)
  pagoEm      DateTime?
  compra      Compra?          @relation(fields: [compraId], references: [id])
  compraId    Int?
  movimentos  MovimentoCaixa[]
  createdAt   DateTime         @default(now())
}

model MovimentoCaixa {
  id             Int           @id @default(autoincrement())
  tipo           TipoMovimento
  descricao      String
  valor          Decimal       @db.Decimal(12, 2)
  data           DateTime      @default(now())

  venda          Venda?        @relation(fields: [vendaId], references: [id])
  vendaId        Int?

  contaReceber   ContaReceber? @relation(fields: [contaReceberId], references: [id])
  contaReceberId Int?

  contaPagar     ContaPagar?   @relation(fields: [contaPagarId], references: [id])
  contaPagarId   Int?

  compra         Compra?       @relation(fields: [compraId], references: [id])
  compraId       Int?

  createdAt      DateTime      @default(now())
}
